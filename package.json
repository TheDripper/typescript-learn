{
  "name": "strict-mode-lms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A learning management system for TypeScript, based on The TypeScript Handbook.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=content --watch-path=shared --disable-warning=ExperimentalWarning server/index.ts",
    "build": "vite build",
    "build:static": "VITE_STATIC=1 vite build --outDir dist-static && node --disable-warning=ExperimentalWarning scripts/build-static-data.ts",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "validate": "node --disable-warning=ExperimentalWarning scripts/validate-content.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "express": "^5.3.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "shiki": "^4.6.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6"
  }
}
